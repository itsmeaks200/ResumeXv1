GROQ_API_KEY=your_groq_api_key_here

# Gemini TTS — get key from aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Voice options: Zephyr Puck Charon Kore Fenrir Leda Orus Aoede Callirrhoe Autonoe Despina ...
GEMINI_TTS_VOICE=Kore

# Groq TTS — used as a fallback if Gemini TTS fails. Valid voices: autumn diana hannah austin daniel troy
TTS_VOICE=hannah

PORT=5000

# MongoDB — local or Atlas connection string
MONGODB_URI=mongodb://localhost:27017/resumex

# JWT secret — any long random string
JWT_SECRET=change_this_to_a_long_random_secret

# Optional: GitHub personal access token
# Without token: public repos only, 60 req/hr rate limit (fine for interviews)
# With token: private repos accessible, 5000 req/hr
GITHUB_TOKEN=

# Optional: Frontend URL for CORS whitelist (default: http://localhost:5173)
# Set this to your deployed frontend URL in production
CLIENT_URL=http://localhost:5173

# Optional: Redis connection URL for distributed session storage
# Without this, interview sessions are stored in-memory (single instance only — fine for dev/demo).
# With Redis: sessions survive server restarts. Clients can reconnect to an in-progress
# interview after network drops (session is restored from Redis via the "resume" message).
# Required for multi-instance deployments behind a load balancer.
# Local:      redis://localhost:6379
# Upstash:    rediss://:password@host:6380
# Redis Cloud: redis://:password@host:port
REDIS_URL=
